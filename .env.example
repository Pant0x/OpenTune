# Copy .env.local values into the environment when building locally.
# Discord loopback sign-in bakes these in at compile time (option_env!):
#
# Local PowerShell build with Discord sign-in enabled:
#   $e = @{}; Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+?)\s*=\s*(.*)\s*$') { $e[$matches[1]] = $matches[2] } }
#   $env:DISCORD_CLIENT_ID = $e.DISCORD_CLIENT_ID
#   $env:DISCORD_CLIENT_SECRET = $e.DISCORD_CLIENT_SECRET
#
# CI provides DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET as repo secrets instead.
