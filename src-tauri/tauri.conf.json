{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTune",
  "version": "1.0.2",
  "identifier": "com.pant0x.opentune",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OpenTune",
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Music",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugin-libav"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMkIwQzdFNUIwNTBBQzEKUldUQkNnVmJmZ3dyNjJGU0ZsSTFjNWtvaU5oSFMyMDBqRkRJaFBPYXVqMSsvdDcrc0xFdE9uVmsK",
      "endpoints": [
        "https://github.com/Pant0x/OpenTune/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/Pant0x/OpenTune/updater-channel/latest.json"
      ]
    }
  }
}
